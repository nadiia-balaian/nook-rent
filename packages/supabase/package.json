{
  "name": "@nook-rent/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "supabase:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate-cli.ts",
    "supabase:seed-demo": "node --env-file-if-exists=../../.env --import tsx src/seed-demo-cli.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nook-rent/core": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "tsx": "4.23.1"
  }
}
