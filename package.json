{
  "name": "nook-rent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' --recursive --if-present build",
    "build:web": "pnpm --filter @nook-rent/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --parallel --filter @nook-rent/api --filter @nook-rent/web dev",
    "dev:api": "pnpm --filter @nook-rent/api dev",
    "dev:web": "pnpm --filter @nook-rent/web dev",
    "dev:worker": "pnpm --filter @nook-rent/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph:agent-register": "pnpm --filter @nook-rent/the-graph graph:agent-register",
    "graph:agent-status": "pnpm --filter @nook-rent/the-graph graph:agent-status",
    "hedera:preflight": "pnpm --filter @nook-rent/hedera hedera:preflight",
    "hedera:setup": "pnpm --filter @nook-rent/hedera hedera:setup",
    "lint": "eslint .",
    "supabase:migrate": "pnpm --filter @nook-rent/supabase supabase:migrate",
    "supabase:seed-demo": "pnpm --filter @nook-rent/supabase supabase:seed-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "world:agent-address": "pnpm --filter @nook-rent/world world:agent-address",
    "world:hold": "pnpm --filter @nook-rent/world world:hold"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
